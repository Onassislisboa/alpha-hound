# ---------------------------------------------------------------------------
# alpha-hound configuration. Copy to .env and fill in.
# Strategy tunables live in config/strategy.toml, not here. This file is only
# for secrets and endpoints.
# ---------------------------------------------------------------------------

# paper | live
# Nothing in this repo will spend real money while MODE=paper.
MODE=paper

# Comma-separated. solana,bnb,base,robinhood_chain,robinhood_broker
ENABLED_CHAINS=solana

# ---------------------------------------------------------------------------
# Solana
# ---------------------------------------------------------------------------
# A paid RPC is not optional for this workload. Public RPC will rate-limit you
# out of every trade that matters.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=

# Base58 secret key of the trading wallet. Keep a small balance here; this is a
# hot wallet by definition. Use a KMS/HSM signer in production.
SOLANA_PRIVATE_KEY=

# https://portal.jup.ag - required for api.jup.ag/swap/v2
JUPITER_API_KEY=

# Optional websocket firehose of new pump.fun launches.
PUMPPORTAL_WS_URL=wss://pumpportal.fun/api/data

# ---------------------------------------------------------------------------
# EVM chains (BNB Chain 56, Base 8453, Robinhood Chain 4663)
# ---------------------------------------------------------------------------
EVM_PRIVATE_KEY=

BNB_RPC_URL=https://bsc-dataseed.binance.org
BASE_RPC_URL=https://mainnet.base.org
ROBINHOOD_CHAIN_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# https://dashboard.0x.org - aggregated routing on BNB + Base
ZEROEX_API_KEY=

# Robinhood Chain is not on 0x, so it routes through Uniswap V3 directly.
# Verified on chain 4663; override if Uniswap redeploys.
RH_CHAIN_SWAP_ROUTER=0xCaf681a66D020601342297493863E78C959E5cb2
RH_CHAIN_QUOTER_V2=0x33e885eD0Ec9bF04EcfB19341582aADCb4c8A9E7
RH_CHAIN_WETH=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD97

# ---------------------------------------------------------------------------
# Robinhood Crypto brokerage API (US only, majors only - not memecoins)
# https://docs.robinhood.com/crypto/trading
# ---------------------------------------------------------------------------
RH_API_KEY=
# base64 of the raw 32-byte Ed25519 seed
RH_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Data providers (read-only signal sources)
# ---------------------------------------------------------------------------
# Dexscreener needs no key. Birdeye/Helius are optional accelerators.
BIRDEYE_API_KEY=
HELIUS_API_KEY=

# ---------------------------------------------------------------------------
# Fomo / Moby (mobyagent)
# ---------------------------------------------------------------------------
# Neither exposes a public trading API as of 2026-08 - both are mobile-only.
# The relay venue turns a decision into a signed intent you can act on
# manually or forward to your own bridge. Leave blank to disable.
RELAY_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Ops
# ---------------------------------------------------------------------------
STATE_DIR=state
LOG_LEVEL=INFO
# Optional Telegram alerting for fills, kill-switch trips and weight rollbacks.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
